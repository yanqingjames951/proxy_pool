{
    "manifest_version": 3,
    "name": "Proxy Pool",
    "version": "1.0.0",
    "description": "Browser extension for Proxy Pool - Get and manage HTTP/HTTPS proxies",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        },
        "default_title": "Proxy Pool"
    },
    "permissions": [
        "storage",
        "activeTab",
        "clipboardWrite"
    ],
    "host_permissions": [
        "http://*/",
        "https://*/"
    ],
    "background": {
        "service_worker": "background/background.js"
    }
}